# 이 파일을 .env 로 복사한 뒤 값을 채워 사용합니다.
# .env 는 gitignore 대상이므로 실제 키를 여기에 적지 않습니다.

# 카카오 지도 JavaScript 키
VITE_KAKAO_MAP_KEY=

# API base URL. 백엔드 /api/v1 prefix 까지 포함합니다.
VITE_API_BASE_URL=https://oiso-be-production.up.railway.app/api/v1

# mock 데이터 사용 여부.
# true  - 서버 대신 mock 응답을 사용합니다.
# false - 실제 API 를 호출합니다.
# 값을 비워 두면 VITE_API_BASE_URL 유무로 판단합니다.
VITE_USE_MOCK=true

# GA4 측정 ID (G-XXXXXXXXXX).
# 비워 두면 수집하지 않습니다. 로컬·프리뷰에서는 비워 두세요.
VITE_GA_MEASUREMENT_ID=
